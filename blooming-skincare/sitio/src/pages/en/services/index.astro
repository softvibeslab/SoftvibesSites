---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, waLink, formatoPrecio, CATEGORIAS_EN } from '../../../data/site';

const servicios = (await getCollection('servicios'))
  .filter((s) => s.data.tituloEn)
  .sort((a, b) => {
    if (a.data.destacado !== b.data.destacado) return a.data.destacado ? -1 : 1;
    return a.data.precio - b.data.precio;
  });
---

<BaseLayout
  titulo={`Treatments & prices | ${SITE.nombre}`}
  descripcion={SITE.descripcionEn}
  lang="en"
  rutaAlterna="/servicios"
>
  <section class="seccion">
    <div class="contenedor">
      <div class="seccion__intro">
        <span class="etiqueta">Treatments</span>
        <h1>Our services</h1>
        <p>
          Diode laser hair removal, Hollywood Peel, custom facials and facial harmonization in
          Playa del Carmen. Every treatment starts with a skin assessment — we work in English and
          Spanish.
        </p>
      </div>

      <div class="grid-propiedades">
        {
          servicios.map((s) => {
            const d = s.data;
            const mensaje = `Hi Blooming, I'd like to book "${d.tituloEn}". Could you share your availability?`;
            return (
              <article class="card">
                <div class="card__media">
                  <a href={`/en/services/${s.id}`} aria-label={d.tituloEn}>
                    <img src={d.imagen} alt={d.tituloEn} class="card__img" loading="lazy" width="640" height="435" />
                  </a>
                  <div class="card__badges">
                    {d.favorito && <span class="badge badge--favorito">★ Client favourite</span>}
                  </div>
                </div>
                <div class="card__cuerpo">
                  <span class="card__tipo">{CATEGORIAS_EN[d.categoria]}</span>
                  <h3 class="card__titulo"><a href={`/en/services/${s.id}`}>{d.tituloEn}</a></h3>
                  <span class="card__precio">
                    {d.precio > 0 ? <>from {formatoPrecio(d.precio)}</> : <span class="card__cotiza">Quoted at your assessment</span>}
                  </span>
                  <span class="card__meta">{d.duracion}</span>
                  <p class="card__resumen">{d.resumenEn}</p>
                  <div class="card__acciones">
                    <a href={waLink(mensaje)} class="boton boton--whatsapp" target="_blank" rel="noopener">Book</a>
                    <a href={`/en/services/${s.id}`} class="boton boton--secundario">Details</a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      <p class="nota-precios">
        Prices shown are a reference and are confirmed during your assessment, based on what your
        skin needs. Ask about this month's promotions on WhatsApp.
      </p>
    </div>
  </section>
</BaseLayout>

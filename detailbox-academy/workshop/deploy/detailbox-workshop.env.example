# /etc/detailbox-workshop.env (root:detailboxws 0640). Sin secretos: el copiloto
# usa el perfil Hermes de DETAILBOX_HERMES_PROFILE_DIR; si no existe, la app ofrece
# «copiar prompt» en lugar de responder (workbook §6).
WORKSHOP_DATA_DIR=/var/lib/detailbox-workshop/data
WORKSHOP_PUBLIC_URL=https://detailbox.softvibes.art
WORKSHOP_SECURE_COOKIES=1
WORKSHOP_TRUST_PROXY=1
DETAILBOX_HERMES_ROOT=/usr/local/lib/hermes-agent
DETAILBOX_HERMES_PROFILE_DIR=/var/lib/detailbox-workshop/hermes/profiles/detailbox-pad
HOME=/var/lib/detailbox-workshop

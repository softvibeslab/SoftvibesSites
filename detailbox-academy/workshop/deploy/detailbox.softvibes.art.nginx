# /etc/nginx/sites-available/detailbox.softvibes.art — Workshop PAD (proxy a gunicorn :8796)
# certbot --nginx -d detailbox.softvibes.art agrega el bloque 443 y la redirección.
server {
    listen 80;
    server_name detailbox.softvibes.art;

    client_max_body_size 9m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location / {
        proxy_pass http://127.0.0.1:8796;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 100s;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, waLink, formatoPrecio } from '../../../data/site';

export async function getStaticPaths() {
  const propiedades = await getCollection('propiedades');
  return propiedades
    .filter((p) => p.data.tituloEn)
    .map((p) => ({ params: { slug: p.id }, props: { propiedad: p } }));
}

const { propiedad } = Astro.props;
const d = propiedad.data;
const titulo = d.tituloEn ?? d.titulo;
const resumen = d.resumenEn ?? d.resumen;

const zonaNombre: Record<string, string> = {
  'playa-del-carmen': 'Playa del Carmen',
  cancun: 'Cancún',
  tulum: 'Tulum',
};

const etiquetaEstatus: Record<string, { texto: string; clase: string } | null> = {
  venta: null,
  preventa: { texto: 'Pre-construction', clase: 'badge--preventa' },
  'entrega-inmediata': { texto: 'Move-in ready', clase: 'badge--entrega' },
  oportunidad: { texto: 'Opportunity', clase: 'badge--oportunidad' },
};
const badgeEstatus = etiquetaEstatus[d.estatus];

const precioM2 = Math.round(d.precio / d.m2);
const mensajeWa = `Hi Katya, I'm interested in "${titulo}" that I saw on your website. Could you send me more information?`;
const mensajeAgenda = `Hi Katya, I'd like to schedule a showing or video call for "${titulo}".`;

const schemaPropiedad = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: titulo,
  description: resumen,
  image: new URL(d.imagen, Astro.site).href,
  category: 'Real Estate',
  offers: {
    '@type': 'Offer',
    price: d.precio,
    priceCurrency: d.moneda,
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'RealEstateAgent', name: SITE.nombre, telephone: SITE.telefono },
  },
};
---

<BaseLayout
  titulo={`${titulo} | Katya Varela · Inversiones Riviera Maya`}
  descripcion={resumen}
  schema={schemaPropiedad}
  lang="en"
  rutaAlterna={`/propiedades/${propiedad.id}`}
>
  <section
    class="detalle-hero detalle-hero--banner"
    style={`background-image: url('${d.imagen}')`}
  >
    <div class="contenedor">
      <nav style="font-size: 0.85rem; margin-bottom: 1rem;" aria-label="Breadcrumbs">
        <a href="/en/properties">Properties</a> ·
        <span>{zonaNombre[d.zona]}</span>
      </nav>
      <div class="detalle-badges">
        {badgeEstatus && <span class={`badge ${badgeEstatus.clase}`}>{badgeEstatus.texto}</span>}
        {d.frenteAlMar && <span class="badge badge--mar">Oceanfront</span>}
      </div>
      <h1>{titulo}</h1>
      <div class="detalle-precio">{formatoPrecio(d.precio, d.moneda)}</div>
      <div class="detalle-meta">
        <span>📍 {d.ubicacion}</span>
        <span>📐 {d.m2} m²</span>
        {d.recamaras && <span>🛏 {d.recamaras} bedrooms</span>}
        {d.banos && <span>🛁 {d.banos} bathrooms</span>}
      </div>
      {d.unidades && <span class="urgencia">Only {d.unidades} units left in this stage</span>}
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      {
        d.ejemplo && (
          <p class="aviso-ejemplo">
            ⚠️ <strong>Sample listing.</strong> This property card is for demonstration —
            contact Katya for current inventory with this profile.
          </p>
        )
      }
      <div class="detalle-cuerpo">
        <div>
          <div class="numeros-inversion" style="margin-top: 0;">
            <div>
              <span class="dato">{formatoPrecio(precioM2, d.moneda)}</span>
              <span class="concepto">Price per m²</span>
            </div>
            <div>
              <span class="dato">{d.m2} m²</span>
              <span class="concepto">Surface</span>
            </div>
            {
              d.formasPagoEn.length > 0 && (
                <div>
                  <span class="dato">{d.formasPagoEn.length > 1 ? `${d.formasPagoEn.length} plans` : 'Direct plan'}</span>
                  <span class="concepto">Payment options</span>
                </div>
              )
            }
            {
              d.unidades && (
                <div>
                  <span class="dato">{d.unidades}</span>
                  <span class="concepto">Units in stage</span>
                </div>
              )
            }
          </div>
          {
            (d.roiEstimadoEn ?? d.roiEstimado) && (
              <p class="mini-testimonio" style="margin-bottom: 2rem;">
                📈 <strong style="display: inline;">Investment profile:</strong> {d.roiEstimadoEn ?? d.roiEstimado}
              </p>
            )
          }

          <div class="prosa">
            {d.parrafosEn.map((p) => <p>{p}</p>)}
          </div>

          {
            d.video && (
              <section class="recorrido">
                <h2>Video walkthrough</h2>
                <video
                  class="recorrido__video"
                  src={d.video}
                  poster={d.imagen}
                  controls
                  playsinline
                  preload="none"
                  aria-label={`Video walkthrough of ${d.tituloEn ?? d.titulo}`}
                />
                <p class="recorrido__nota">Walkthrough video of the property.</p>
              </section>
            )
          }

          {
            d.galeria.length > 0 && (
              <section class="galeria">
                <h2>Gallery</h2>
                <div class="galeria__grid">
                  {d.galeria.map((foto, i) => (
                    <button class="galeria__item" type="button" data-foto={foto} aria-label={`Enlarge photo ${i + 1}`}>
                      <img src={foto} alt={`${d.tituloEn ?? d.titulo} — photo ${i + 1}`} loading="lazy" width="900" height="630" />
                    </button>
                  ))}
                </div>
              </section>
            )
          }

          {
            d.formasPagoEn.length > 0 && (
              <>
                <h2>Payment options</h2>
                <ul class="lista-check">
                  {d.formasPagoEn.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </>
            )
          }
        </div>

        <aside class="detalle-lateral">
          <div class="asesora-card">
            <div class="asesora-card__perfil">
              <img
                src="/img/katya.jpg"
                alt={`${SITE.asesor}, real estate investment advisor`}
                class="asesora-card__foto"
                width="72"
                height="72"
              />
              <div>
                <div class="asesora-card__nombre">{SITE.asesor}</div>
                <div class="asesora-card__titulo">Investment advisor · Riviera Maya</div>
              </div>
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: var(--gris);">
              I'll send you the brochure, availability and a full financial breakdown for this
              property — in English.
            </p>
            <a href={waLink(mensajeWa)} class="boton boton--whatsapp" target="_blank" rel="noopener">💬 Request info</a>
            <a href={waLink(mensajeAgenda)} class="boton boton--primario" target="_blank" rel="noopener">📅 Book a showing / video call</a>
            <a href={`tel:${SITE.telefono.replace(/\s/g, '')}`} class="boton boton--secundario">
              📞 {SITE.telefono}
            </a>
            <p class="mini-testimonio">
              "He explained the numbers and the legal side with a clarity we hadn't found with
              anyone else."
              <strong>— Investment client (sample testimonial)</strong>
            </p>
          </div>
          <div class="asesora-card" style="border-top-color: var(--teal);">
            <h3 style="margin: 0; font-size: 1.05rem;">Legal certainty included</h3>
            <ul class="lista-check" style="font-size: 0.88rem;">
              {(d.caracteristicasEn.length ? d.caracteristicasEn : d.caracteristicas).slice(0, 6).map((c) => <li>{c}</li>)}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <div class="barra-movil">
    <a href={waLink(mensajeWa)} class="boton boton--whatsapp" target="_blank" rel="noopener">💬 WhatsApp</a>
    <a href={waLink(mensajeAgenda)} class="boton boton--primario" target="_blank" rel="noopener">📅 Book</a>
  </div>
  <!-- Lightbox -->
  <div class="visor" id="visor" hidden>
    <button class="visor__cerrar" type="button" aria-label="Close">×</button>
    <button class="visor__nav visor__nav--prev" type="button" aria-label="Previous photo">‹</button>
    <img class="visor__img" id="visor-img" src="" alt="" />
    <button class="visor__nav visor__nav--next" type="button" aria-label="Next photo">›</button>
  </div>

  <script>
    const visor = document.getElementById('visor');
    const visorImg = document.getElementById('visor-img') as HTMLImageElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>('.galeria__item'));

    if (visor && visorImg && items.length) {
      let actual = 0;
      const fotos = items.map((b) => b.dataset.foto || '');

      const mostrar = (i: number) => {
        actual = (i + fotos.length) % fotos.length;
        visorImg.src = fotos[actual];
      };
      const abrir = (i: number) => {
        mostrar(i);
        visor.hidden = false;
        document.body.style.overflow = 'hidden';
      };
      const cerrar = () => {
        visor.hidden = true;
        document.body.style.overflow = '';
      };

      items.forEach((b, i) => b.addEventListener('click', () => abrir(i)));
      visor.querySelector('.visor__cerrar')?.addEventListener('click', cerrar);
      visor.querySelector('.visor__nav--prev')?.addEventListener('click', (e) => {
        e.stopPropagation();
        mostrar(actual - 1);
      });
      visor.querySelector('.visor__nav--next')?.addEventListener('click', (e) => {
        e.stopPropagation();
        mostrar(actual + 1);
      });
      visor.addEventListener('click', (e) => {
        if (e.target === visor || e.target === visorImg) cerrar();
      });
      document.addEventListener('keydown', (e) => {
        if (visor.hidden) return;
        if (e.key === 'Escape') cerrar();
        if (e.key === 'ArrowLeft') mostrar(actual - 1);
        if (e.key === 'ArrowRight') mostrar(actual + 1);
      });
    }
  </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, waLink } from '../config/site';
---

<BaseLayout titulo={`Enlaces | ${SITE.nombre}`} descripcion={`Enlaces principales de ${SITE.nombre}.`} desnudo>
  <section class="links"><div class="links__tarjeta"><span class="marca__simbolo">H</span><h1>{SITE.nombre}</h1><p>{SITE.lema}</p><div class="links__lista"><a class="boton boton--acento" href={waLink()} target="_blank" rel="noopener">WhatsApp</a><a class="boton" href={SITE.agenda} target="_blank" rel="noopener">Agendar</a><a class="boton" href="/propiedades">Propiedades</a><a class="boton" href="/">Sitio principal</a></div><small>Plantilla demostrativa</small></div></section>
</BaseLayout>

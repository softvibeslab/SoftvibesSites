# Políticas de caché pensadas para un sitio editable por CMS:
# - HTML e imágenes: revalidar siempre (peticiones 304 baratas, cambios visibles al instante)
# - Assets con hash en el nombre (/_astro/): caché larga e inmutable

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 0 seconds"
  ExpiresByType image/png "access plus 0 seconds"
  ExpiresByType image/webp "access plus 0 seconds"
  ExpiresByType image/gif "access plus 0 seconds"
  ExpiresByType image/avif "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|avif|svg|ico)$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always unset Expires
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|woff)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Desactivar la caché de página de LiteSpeed (el CMS reescribe los HTML)
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

# Los JSON del CMS (catálogo y respaldos) no deben ser descargables públicamente
<FilesMatch "^(media|contenido)\.json$">
  Require all denied
</FilesMatch>

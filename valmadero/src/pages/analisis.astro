---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, waLink } from '../config/site';

const metricas = [
  { valor: 6547, sufijo: '', decimales: 0, etiqueta: 'seguidores al corte' },
  { valor: 12, sufijo: '', decimales: 0, etiqueta: 'publicaciones en la muestra' },
  { valor: 10, sufijo: '/12', decimales: 0, etiqueta: 'piezas en formato video' },
  { valor: 4.1, sufijo: '×', decimales: 1, etiqueta: 'más likes en contenido personal' },
];

const hallazgos = [
  {
    icono: '01',
    titulo: 'La historia personal abre más puertas que el inventario',
    detalle: 'Las cuatro piezas personales promedian 242 likes; las ocho inmobiliarias, 58.9. En esta muestra, la afinidad personal obtiene aproximadamente 4.1 veces más respuesta.',
    solucion: 'Aplicado: la landing abre con una decisión de vida y presenta a Val antes de llevar a opciones, educación y contacto.',
    estado: 'aplicado',
  },
  {
    icono: '02',
    titulo: 'El siguiente paso cambia entre comentario, DM y WhatsApp',
    detalle: 'Cada llamada a la acción obliga al prospecto a decidir por dónde continuar y a volver a explicar qué busca. Ese salto pierde contexto y hace más lenta la conversación.',
    solucion: 'Aplicado: el sitio segmenta vivir, invertir o entender crédito y conduce a una conversación de WhatsApp con una promesa consistente.',
    estado: 'aplicado',
  },
  {
    icono: '03',
    titulo: 'Una publicación de propiedad envejece sin avisar',
    detalle: 'Precio, disponibilidad, superficie y financiamiento pueden cambiar después de publicar. Un feed no distingue automáticamente una referencia histórica de inventario vigente.',
    solucion: 'Aplicado: las referencias llevan fuente, fecha y estado de verificación; el CMS permite actualizar o retirar información sin rehacer el sitio.',
    estado: 'aplicado',
  },
  {
    icono: '04',
    titulo: 'El contenido educa, pero no explica el acompañamiento completo',
    detalle: 'Crédito, enganche, Airbnb y plusvalía generan preguntas útiles, aunque el perfil no muestra en un solo lugar qué ocurre después del primer mensaje.',
    solucion: 'Aplicado: la propuesta convierte el servicio en una ruta visible — escuchar, filtrar y decidir con contexto.',
    estado: 'aplicado',
  },
  {
    icono: '05',
    titulo: 'La infraestructura comercial todavía necesita datos definitivos',
    detalle: 'El dominio, correo receptor, teléfono, responsable de privacidad, relación con Blestyum y analítica deben confirmarse antes de abrir la indexación.',
    solucion: 'Pendiente: completar identidad operativa, privacidad y medición antes de presentar el prototipo como sitio oficial.',
    estado: 'pendiente',
  },
];

const pilares = [
  {
    numero: '4 piezas',
    titulo: 'Vida en el Caribe',
    texto: 'Construye afinidad, hace memorable a Val y produce la mayor respuesta de la muestra.',
    funcion: 'Atracción',
  },
  {
    numero: 'Temas útiles',
    titulo: 'Educación inmobiliaria',
    texto: 'Crédito, enganche, gastos y Airbnb convierten curiosidad en preguntas concretas.',
    funcion: 'Consideración',
  },
  {
    numero: '8 piezas',
    titulo: 'Producto y oportunidad',
    texto: 'Casas, departamentos, lotes y villas aterrizan la intención, con control de vigencia.',
    funcion: 'Conversión',
  },
];

const mejoras = [
  { icono: '◎', titulo: 'Posicionamiento propio', texto: '“Tu siguiente paso en Riviera Maya, explicado claro” une vida, educación y producto en una sola promesa.' },
  { icono: '↗', titulo: 'Rutas por intención', texto: 'Vivir, invertir o entender crédito permite responder desde el objetivo, no desde una lista infinita.' },
  { icono: '▶', titulo: 'Contenido en movimiento', texto: 'Siete videos autorizados llevan la presencia cercana de Instagram a una galería web rápida y responsive.' },
  { icono: 'WA', titulo: 'Conversación contextual', texto: 'Las llamadas a la acción llevan a un canal principal y mantienen visible el motivo del contacto.' },
  { icono: '✓', titulo: 'Inventario responsable', texto: 'Las referencias separan demostración y vigencia; el CMS conserva fuente, fecha y estado.' },
  { icono: '⌂', titulo: 'Ecosistema completo', texto: 'Landing, propiedades, zonas, guías, enlaces, contacto y CMS viven bajo la misma arquitectura.' },
];

const fases = [
  {
    paso: '01',
    titulo: 'Confirmar',
    etiqueta: 'Antes de indexar',
    items: ['Dominio y correo definitivos', 'Teléfono y razón comercial', 'Aviso de privacidad y responsable', 'Relación pública con Blestyum'],
  },
  {
    paso: '02',
    titulo: 'Operar',
    etiqueta: 'Primera semana',
    items: ['Cargar inventario autorizado', 'Asignar fecha y responsable', 'Probar formulario y respaldos', 'Definir rutina de actualización'],
  },
  {
    paso: '03',
    titulo: 'Activar',
    etiqueta: 'Después de validar',
    items: ['Conectar dominio y Search Console', 'Habilitar analítica de conversiones', 'Actualizar enlace de la bio', 'Medir visitas, clics y contactos'],
  },
];

const tour = [
  { etiqueta: '1 · Inicio', url: `${SITE.dominio}/`, nota: 'La marca recibe desde una decisión de vida y segmenta la intención.' },
  { etiqueta: '2 · Videos', url: `${SITE.dominio}/#videos`, nota: 'La cercanía de Instagram se conserva en una galería propia y navegable.' },
  { etiqueta: '3 · Opciones', url: `${SITE.dominio}/propiedades/`, nota: 'Las referencias se presentan con contexto, fuente y estado de verificación.' },
  { etiqueta: '4 · Enlaces', url: `${SITE.dominio}/links/`, nota: 'La bio puede conducir a un punto de entrada con la identidad de Val.' },
  { etiqueta: '5 · Contacto', url: `${SITE.dominio}/contacto/`, nota: 'El prospecto comparte objetivo y presupuesto antes de la conversación.' },
];
---

<BaseLayout
  titulo={`Análisis digital de ${SITE.nombre} | Softvibes`}
  descripcion="Diagnóstico de marca, contenido y conversión de Val Madero basado en una muestra pública de Instagram."
  imagen="/media/valmadero/valeria-soto-madero.jpg"
  desnudo
  noindex
>
  <div class="analysis-page">
    <header class="analysis-hero">
      <a class="analysis-brand" href="/" aria-label={`Volver al sitio de ${SITE.nombre}`}>
        <span>V</span>
        <strong>{SITE.nombre}</strong>
      </a>
      <div class="hero-orbit hero-orbit--one" aria-hidden="true"></div>
      <div class="hero-orbit hero-orbit--two" aria-hidden="true"></div>
      <img class="hero-portrait" src={SITE.asesor.imagen} alt={`Retrato de ${SITE.asesor.nombre}`} />
      <p class="eyebrow eyebrow--light">Análisis de presencia digital · 3 de agosto de 2026</p>
      <h1>Val, tu cercanía ya genera atención.<br /><em>Ahora tiene una ruta para convertirla en conversación.</em></h1>
      <p class="hero-copy">Analizamos una muestra pública de tu Instagram, detectamos dónde se pierde el contexto y construimos una propuesta para unir contenido, asesoría e inventario responsable.</p>
      <div class="hero-note">Preparado por <strong>Softvibes</strong> · diagnóstico basado en datos públicos y activos autorizados</div>
    </header>

    <section class="metrics" aria-label="Resumen cuantitativo">
      {metricas.map((metrica) => (
        <article class="metric">
          <strong
            data-counter
            data-target={metrica.valor}
            data-suffix={metrica.sufijo}
            data-decimals={metrica.decimales}
          >0</strong>
          <span>{metrica.etiqueta}</span>
        </article>
      ))}
    </section>

    <section class="media-story analysis-container" aria-labelledby="media-title">
      <div class="section-heading section-heading--center" data-analysis-reveal>
        <p class="eyebrow">La señal más valiosa</p>
        <h2 id="media-title">La persona es el punto de entrada</h2>
        <p>La muestra no pide abandonar el contenido inmobiliario. Pide conectarlo mejor con la historia y la confianza que Val ya construye.</p>
      </div>
      <div class="story-gallery">
        <figure class="story-card" data-analysis-reveal>
          <img src="/media/valmadero/valeria-soto-madero.jpg" alt="Valeria Soto Madero" loading="lazy" />
          <figcaption><strong>Cercanía</strong><span>La persona hace memorable la marca.</span></figcaption>
        </figure>
        <figure class="story-card" data-analysis-reveal>
          <img src="/media/valmadero/reel-03-primer-departamento.jpg" alt="Recorrido por un departamento" loading="lazy" />
          <figcaption><strong>Claridad</strong><span>El contenido traduce espacios y decisiones.</span></figcaption>
        </figure>
        <figure class="story-card" data-analysis-reveal>
          <img src="/media/valmadero/reel-05-lotes-tulum.jpg" alt="Contenido inmobiliario sobre Tulum" loading="lazy" />
          <figcaption><strong>Oportunidad</strong><span>El producto aparece después del contexto.</span></figcaption>
        </figure>
      </div>
      <p class="gallery-note">242 likes promedio en contenido personal frente a 58.9 en contenido inmobiliario. <strong>El hallazgo es direccional, no una medición de ventas.</strong></p>
    </section>

    <section class="findings-section">
      <div class="analysis-container">
        <div class="section-heading section-heading--center" data-analysis-reveal>
          <p class="eyebrow">El diagnóstico</p>
          <h2>Lo que encontramos y cómo lo abordamos</h2>
          <p>Abre cada hallazgo para separar la evidencia, la decisión aplicada y lo que todavía requiere confirmación.</p>
        </div>
        <div class="findings-list">
          {hallazgos.map((hallazgo, index) => (
            <article class:list={['finding', hallazgo.estado === 'pendiente' && 'finding--pending', index === 0 && 'is-open']} data-finding data-analysis-reveal>
              <button type="button" aria-expanded={index === 0 ? 'true' : 'false'}>
                <span class="finding-number">{hallazgo.icono}</span>
                <span class="finding-title">{hallazgo.titulo}</span>
                <span class="finding-status">{hallazgo.estado}</span>
                <span class="finding-arrow" aria-hidden="true">⌄</span>
              </button>
              <div class="finding-detail">
                <div>
                  <p>{hallazgo.detalle}</p>
                  <p class="finding-solution"><strong>{hallazgo.solucion.split(':')[0]}:</strong>{hallazgo.solucion.split(':').slice(1).join(':')}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pillars-section analysis-container" aria-labelledby="pillars-title">
      <div class="section-heading" data-analysis-reveal>
        <p class="eyebrow">Arquitectura editorial</p>
        <h2 id="pillars-title">Tres territorios, una función para cada uno</h2>
        <p>El sitio no reemplaza el contenido: le asigna un lugar dentro del recorrido comercial.</p>
      </div>
      <div class="pillar-grid">
        {pilares.map((pilar) => (
          <article class="pillar" data-analysis-reveal>
            <div class="pillar-top"><span>{pilar.numero}</span><strong>{pilar.funcion}</strong></div>
            <h3>{pilar.titulo}</h3>
            <p>{pilar.texto}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="transformation" aria-labelledby="transformation-title">
      <div class="analysis-container">
        <div class="section-heading section-heading--center section-heading--light">
          <p class="eyebrow eyebrow--light">La transformación</p>
          <h2 id="transformation-title">Del contenido suelto a una ruta propia</h2>
          <p>Cambia la vista para comparar el recorrido actual con el sistema propuesto.</p>
        </div>

        <div class="view-switch" role="tablist" aria-label="Comparar antes y ahora">
          <button class="is-active" type="button" data-scene-button="before" role="tab" aria-selected="true">Antes</button>
          <button type="button" data-scene-button="after" role="tab" aria-selected="false">Ahora</button>
        </div>

        <div class="scene" data-scene="before">
          <div class="before-grid">
            <article class="before-card before-card--instagram">
              <div class="app-label"><span>Instagram</span><i>atención</i></div>
              <strong>@_valmadero</strong>
              <p>El contenido genera afinidad, preguntas y descubrimiento.</p>
              <div class="mini-feed" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            </article>
            <article class="before-card">
              <div class="app-label"><span>Comentarios y DM</span><i>fragmentado</i></div>
              <div class="message message--left">Info</div>
              <div class="message message--right">¿De qué propiedad?</div>
              <div class="message message--left">La que vi ayer…</div>
            </article>
            <article class="before-card">
              <div class="app-label"><span>WhatsApp</span><i>sin contexto</i></div>
              <div class="message message--left">Hola</div>
              <div class="message message--right">¡Hola! ¿Qué buscas?</div>
              <div class="message message--left">Algo para invertir</div>
            </article>
            <article class="before-card">
              <div class="app-label"><span>Publicación</span><i>vigencia incierta</i></div>
              <div class="property-placeholder"><span>$4.2 M</span><small>¿Sigue disponible?</small></div>
            </article>
          </div>
          <p class="scene-verdict">“La atención existe, pero el prospecto debe reconstruir el contexto.”</p>
        </div>

        <div class="scene" data-scene="after" hidden>
          <div class="source-chips" aria-label="Canales que convergen en el sitio">
            <span>Instagram</span><span>Reels</span><span>WhatsApp</span><span>Google</span>
          </div>
          <p class="converge">todos conducen a una misma ruta <i aria-hidden="true"></i></p>

          <div class="device-tabs" role="tablist" aria-label="Vista por dispositivo">
            <button type="button" data-device="laptop">Laptop</button>
            <button type="button" data-device="tablet">Tablet</button>
            <button class="is-active" type="button" data-device="phone">Teléfono</button>
          </div>

          <div class="device device--phone" data-device-frame>
            <div class="device-notch" aria-hidden="true"></div>
            <div class="device-screen" data-device-screen>
              <iframe
                data-tour-frame
                data-src={tour[0].url}
                src="about:blank"
                title={`Sitio de ${SITE.nombre} en vivo`}
                loading="lazy"
              ></iframe>
            </div>
            <div class="device-base" aria-hidden="true"></div>
          </div>

          <div class="tour-tabs" role="tablist" aria-label="Recorrido por el sitio">
            {tour.map((item, index) => (
              <button
                class:list={[index === 0 && 'is-active']}
                type="button"
                data-tour-url={item.url}
                data-tour-note={item.nota}
              >{item.etiqueta}</button>
            ))}
          </div>
          <p class="tour-note" data-tour-note-output>{tour[0].nota}</p>
          <div class="scene-cta"><a class="analysis-button analysis-button--accent" href={SITE.dominio} target="_blank" rel="noopener">Abrir la landing completa ↗</a></div>
          <p class="scene-verdict">“El mismo contenido, ahora conectado a intención, contexto y seguimiento.”</p>
        </div>
      </div>
    </section>

    <section class="improvements-section analysis-container">
      <div class="section-heading section-heading--center" data-analysis-reveal>
        <p class="eyebrow">Lo que ya está construido</p>
        <h2>La propuesta convierte el análisis en producto</h2>
        <p>No es una lista de recomendaciones aisladas: cada decisión tiene una implementación visible.</p>
      </div>
      <div class="improvements-grid">
        {mejoras.map((mejora) => (
          <article class="improvement" data-analysis-reveal>
            <span>{mejora.icono}</span>
            <h3>{mejora.titulo}</h3>
            <p>{mejora.texto}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="evidence-section">
      <div class="analysis-container evidence-grid">
        <div class="evidence-copy" data-analysis-reveal>
          <p class="eyebrow">Transparencia de datos</p>
          <h2>Qué significan —y qué no— estas cifras</h2>
          <p>La muestra permite detectar patrones editoriales, no atribuir ventas. La interacción proxy usa likes y comentarios sobre seguidores; no incluye alcance, guardados, compartidos, mensajes, pauta ni cierres.</p>
          <details>
            <summary>Ver fuente y alcance técnico</summary>
            <div>
              <p>Perfil público: <a href={SITE.redes.instagram} target="_blank" rel="noopener">@_valmadero</a>.</p>
              <p>Actor: <code>apify/instagram-profile-scraper</code>. Muestra de 12 publicaciones entre julio de 2025 y junio de 2026, recolectada el 3 de agosto de 2026.</p>
              <p>Las URL temporales de medios fueron omitidas del snapshot; el sitio utiliza únicamente archivos proporcionados para esta landing.</p>
            </div>
          </details>
        </div>
        <div class="evidence-table" data-analysis-reveal>
          <div><span>Likes promedio</span><strong>119.9</strong></div>
          <div><span>Mediana de likes</span><strong>71.5</strong></div>
          <div><span>Comentarios promedio</span><strong>1.5</strong></div>
          <div><span>Vistas promedio en video</span><strong>1,314.8</strong></div>
          <div><span>Interacción proxy</span><strong>1.85%</strong></div>
        </div>
      </div>
    </section>

    <section class="roadmap-section analysis-container" id="siguientes-pasos">
      <div class="section-heading section-heading--center" data-analysis-reveal>
        <p class="eyebrow">Hoja de activación</p>
        <h2>De prototipo validado a activo oficial</h2>
        <p>La base técnica está lista. Estos pasos reducen el riesgo antes de abrir el sitio a búsqueda y campañas.</p>
      </div>
      <div class="roadmap-grid">
        {fases.map((fase) => (
          <article class="roadmap-card" data-analysis-reveal>
            <div class="roadmap-head"><span>{fase.paso}</span><small>{fase.etiqueta}</small></div>
            <h3>{fase.titulo}</h3>
            <ul>{fase.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="analysis-cta">
      <p class="eyebrow">La idea central</p>
      <h2>Tu contenido deja de ser una colección de publicaciones<br /><em>y empieza a construir una ruta propia.</em></h2>
      <p>La atención ya existe. La oportunidad está en conservar el contexto hasta la conversación correcta.</p>
      <div>
        <a class="analysis-button analysis-button--accent" href={SITE.dominio} target="_blank" rel="noopener">Ver la landing</a>
        <a class="analysis-button analysis-button--outline" href={waLink()} target="_blank" rel="noopener">Hablar con Val</a>
      </div>
    </section>

    <div class="floating-actions" data-floating-actions>
      <a href={SITE.dominio} target="_blank" rel="noopener">Ver landing</a>
      <a href="#siguientes-pasos">Siguientes pasos</a>
    </div>

    <footer class="analysis-footer">
      <span class="footer-mark">V</span>
      <p>Diagnóstico preparado por <strong>Softvibes</strong> para {SITE.nombre}.</p>
      <p>Prototipo privado y no indexable. Cualquier dato inmobiliario debe confirmarse antes de publicarse.</p>
    </footer>
  </div>

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const formatCounter = (value: number, decimals: number, suffix: string) =>
      `${new Intl.NumberFormat('es-MX', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      }).format(value)}${suffix}`;

    document.querySelectorAll<HTMLElement>('[data-counter]').forEach((counter) => {
      const target = Number(counter.dataset.target ?? 0);
      const decimals = Number(counter.dataset.decimals ?? 0);
      const suffix = counter.dataset.suffix ?? '';
      if (reduceMotion || !('IntersectionObserver' in window)) {
        counter.textContent = formatCounter(target, decimals, suffix);
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        if (!entries[0]?.isIntersecting) return;
        observer.disconnect();
        const start = performance.now();
        const duration = 1100;
        const tick = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          counter.textContent = formatCounter(target * eased, decimals, suffix);
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }, { threshold: 0.45 });
      observer.observe(counter);
    });

    document.querySelectorAll<HTMLElement>('[data-finding]').forEach((finding) => {
      const button = finding.querySelector<HTMLButtonElement>('button');
      button?.addEventListener('click', () => {
        const open = finding.classList.toggle('is-open');
        button.setAttribute('aria-expanded', String(open));
      });
    });

    const scenes = document.querySelectorAll<HTMLElement>('[data-scene]');
    const sceneButtons = document.querySelectorAll<HTMLButtonElement>('[data-scene-button]');
    const tourFrame = document.querySelector<HTMLIFrameElement>('[data-tour-frame]');
    const deviceFrame = document.querySelector<HTMLElement>('[data-device-frame]');
    const deviceScreen = document.querySelector<HTMLElement>('[data-device-screen]');
    let currentDevice: 'phone' | 'tablet' | 'laptop' = 'phone';

    const deviceSizes = {
      phone: { width: 390, height: 800, max: 440 },
      tablet: { width: 834, height: 1024, max: 650 },
      laptop: { width: 1280, height: 800, max: 920 },
    };

    const fitDevice = () => {
      if (!tourFrame || !deviceScreen || !deviceFrame || deviceFrame.closest('[hidden]')) return;
      const config = deviceSizes[currentDevice];
      const available = Math.min(config.max, window.innerWidth - 48);
      let scale = available / config.width;
      const maxHeight = window.innerHeight * 0.72;
      if (config.height * scale > maxHeight) scale = maxHeight / config.height;
      tourFrame.style.width = `${config.width}px`;
      tourFrame.style.height = `${config.height}px`;
      tourFrame.style.transform = `scale(${scale})`;
      deviceScreen.style.width = `${Math.round(config.width * scale)}px`;
      deviceScreen.style.height = `${Math.round(config.height * scale)}px`;
    };

    sceneButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const next = button.dataset.sceneButton;
        sceneButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', String(active));
        });
        scenes.forEach((scene) => { scene.hidden = scene.dataset.scene !== next; });
        if (next === 'after' && tourFrame?.src === 'about:blank') tourFrame.src = tourFrame.dataset.src ?? '/';
        requestAnimationFrame(fitDevice);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-device]').forEach((button) => {
      button.addEventListener('click', () => {
        currentDevice = (button.dataset.device ?? 'phone') as typeof currentDevice;
        document.querySelectorAll('[data-device]').forEach((item) => item.classList.toggle('is-active', item === button));
        if (deviceFrame) deviceFrame.className = `device device--${currentDevice}`;
        fitDevice();
      });
    });
    window.addEventListener('resize', fitDevice, { passive: true });

    const tourNote = document.querySelector<HTMLElement>('[data-tour-note-output]');
    document.querySelectorAll<HTMLButtonElement>('[data-tour-url]').forEach((button) => {
      button.addEventListener('click', () => {
        document.querySelectorAll('[data-tour-url]').forEach((item) => item.classList.toggle('is-active', item === button));
        if (tourFrame) tourFrame.src = button.dataset.tourUrl ?? '/';
        if (tourNote) tourNote.textContent = button.dataset.tourNote ?? '';
        button.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      });
    });

    const revealElements = document.querySelectorAll<HTMLElement>('[data-analysis-reveal]');
    if (reduceMotion || !('IntersectionObserver' in window)) {
      revealElements.forEach((element) => element.classList.add('is-visible'));
    } else {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        });
      }, { threshold: 0.12 });
      revealElements.forEach((element) => revealObserver.observe(element));
    }

    const floatingActions = document.querySelector<HTMLElement>('[data-floating-actions]');
    const transformation = document.querySelector('.transformation');
    const roadmap = document.querySelector('.roadmap-section');
    if (floatingActions && transformation && roadmap && 'IntersectionObserver' in window) {
      let passedTransformation = false;
      let roadmapVisible = false;
      const updateFloating = () => floatingActions.classList.toggle('is-visible', passedTransformation && !roadmapVisible);
      new IntersectionObserver((entries) => {
        if (entries[0]?.isIntersecting) passedTransformation = true;
        updateFloating();
      }, { threshold: 0.2 }).observe(transformation);
      new IntersectionObserver((entries) => {
        roadmapVisible = Boolean(entries[0]?.isIntersecting);
        updateFloating();
      }, { threshold: 0.08 }).observe(roadmap);
    }
  </script>


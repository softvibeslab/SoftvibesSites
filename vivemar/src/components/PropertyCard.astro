---
import type { CollectionEntry } from 'astro:content';
import { waLink, formatoPrecio } from '../data/site';

interface Props {
  propiedad: CollectionEntry<'propiedades'>;
}

const { propiedad } = Astro.props;
const {
  titulo,
  resumen,
  precio,
  moneda,
  tipo,
  zona,
  ubicacion,
  m2,
  recamaras,
  banos,
  imagen,
  estatus,
  frenteAlMar,
} = propiedad.data;
const url = `/propiedades/${propiedad.id}`;

const etiquetaTipo: Record<string, string> = {
  departamento: 'Departamento',
  penthouse: 'Penthouse',
  casa: 'Casa',
  lote: 'Lote de inversión',
};

const etiquetaEstatus: Record<string, { texto: string; clase: string } | null> = {
  venta: null,
  preventa: { texto: 'Preventa', clase: 'badge--preventa' },
  'entrega-inmediata': { texto: 'Entrega inmediata', clase: 'badge--entrega' },
  oportunidad: { texto: 'Oportunidad', clase: 'badge--oportunidad' },
};

const badgeEstatus = etiquetaEstatus[estatus];
const mensajeWa = `Hola Viridiana, me interesa "${titulo}" que vi en vivemarrealestate.com. ¿Me compartes más información?`;
---

<article class="card" data-tipo={tipo} data-zona={zona} data-precio={precio}>
  <div class="card__media">
    <a href={url} aria-label={titulo}>
      <img src={imagen} alt={titulo} class="card__img" loading="lazy" width="640" height="400" />
    </a>
    <div class="card__badges">
      {badgeEstatus && <span class={`badge ${badgeEstatus.clase}`}>{badgeEstatus.texto}</span>}
      {frenteAlMar && <span class="badge badge--mar">Frente al mar</span>}
    </div>
  </div>
  <div class="card__cuerpo">
    <span class="card__tipo">{etiquetaTipo[tipo]}</span>
    <h3 class="card__titulo"><a href={url} data-cms={`prop-${propiedad.id}-titulo`}>{titulo}</a></h3>
    <span class="card__precio">
      {formatoPrecio(precio, moneda)}
      <small>· {formatoPrecio(Math.round(precio / m2), moneda)}/m²</small>
    </span>
    <span class="card__meta">
      📍 {ubicacion} · {m2} m²{recamaras ? ` · ${recamaras} rec` : ''}{banos ? ` · ${banos} baños` : ''}
    </span>
    <p class="card__resumen" data-cms={`prop-${propiedad.id}-resumen`}>{resumen}</p>
    <div class="card__acciones">
      <a href={waLink(mensajeWa)} class="boton boton--whatsapp" target="_blank" rel="noopener" data-cms="cta-card-whatsapp">WhatsApp</a>
      <a href={url} class="boton boton--secundario" data-cms="cta-card-ver">Ver propiedad</a>
    </div>
  </div>
</article>
